NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Base URL used for Supabase password-reset links (for local development, http://localhost:3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Used only for boss user invitations. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Set a long random value for the Vercel scheduled reminder endpoint.
CRON_SECRET=replace-with-a-long-random-secret
